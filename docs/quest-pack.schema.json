{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/questjournal/quest.schema.json",
  "title": "Quest Journal quest (schema_version 1)",
  "description": "One quest per file. Comments (// and /* */) are accepted by Quest Journal but are not valid JSON Schema input; strip them for strict validators.",
  "type": "object",
  "required": ["id", "title", "category"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9_.-]{1,64}:[a-z0-9_./-]{1,100}$", "maxLength": 128 },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "short_description": { "type": "string", "maxLength": 300 },
    "description": { "type": "string", "maxLength": 20000 },
    "category": { "enum": ["main_story", "side_quests", "world_quests", "boss_quests", "main", "side", "world", "boss"] },
    "icon": { "$ref": "#/definitions/registryId" },
    "enabled": { "type": "boolean" },
    "sort_order": { "type": "integer", "minimum": -1000000, "maximum": 1000000 },
    "visibility": { "enum": ["always", "when_available", "when_active"] },
    "acceptance": { "enum": ["auto", "manual"] },
    "prerequisites": { "type": "array", "maxItems": 1000, "items": { "type": "string", "pattern": "^[a-z0-9_.-]{1,64}:[a-z0-9_./-]{1,100}$" } },
    "prerequisite_mode": { "enum": ["all", "any"] },
    "objective_mode": { "enum": ["all_at_once", "sequential"] },
    "abandon": { "enum": ["disabled", "preserve_progress", "reset_progress"] },
    "objectives": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/definitions/objective" } },
    "rewards": { "type": "array", "maxItems": 200, "items": { "$ref": "#/definitions/reward" } },
    "lore": { "type": "array", "maxItems": 500, "items": { "$ref": "#/definitions/lorePage" } },
    "dialogues": { "type": "array", "maxItems": 200, "items": { "$ref": "#/definitions/dialogue" } }
  },
  "definitions": {
    "registryId": { "type": "string", "pattern": "^([a-z0-9_.-]{1,64}:)?[a-z0-9_./-]{1,100}$" },
    "localId": { "type": "string", "pattern": "^[a-z0-9_]{1,64}$" },
    "objective": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "$ref": "#/definitions/localId" },
        "type": { "enum": ["kill_entity", "obtain_item", "have_item", "deliver_item", "visit_dimension", "visit_location", "break_block", "interact_block"] },
        "target": { "$ref": "#/definitions/registryId" },
        "count": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "description": { "type": "string", "maxLength": 400 },
        "required": { "type": "boolean" },
        "track_before_unlock": { "type": "boolean" },
        "x": { "type": "number" }, "y": { "type": "number" }, "z": { "type": "number" },
        "radius": { "type": "integer", "minimum": 1, "maximum": 1000000 }
      },
      "allOf": [
        { "required": ["target"] },
        { "if": { "properties": { "type": { "const": "visit_location" } } }, "then": { "required": ["x", "y", "z"] } }
      ]
    },
    "reward": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "id": { "$ref": "#/definitions/localId" },
        "type": { "enum": ["item", "experience", "command", "custom"] },
        "item": { "$ref": "#/definitions/registryId" },
        "count": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "nbt": { "type": "string", "maxLength": 4000 },
        "amount": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "unit": { "enum": ["points", "levels"] },
        "command": { "type": "string", "maxLength": 512 },
        "label": { "type": "string", "maxLength": 200 },
        "provider": { "type": "string", "pattern": "^[a-z0-9_.:/-]{1,100}$" },
        "data": { "type": "object" }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "item" } } }, "then": { "required": ["item"] } },
        { "if": { "properties": { "type": { "const": "experience" } } }, "then": { "required": ["amount"] } },
        { "if": { "properties": { "type": { "const": "command" } } }, "then": { "required": ["command"] } },
        { "if": { "properties": { "type": { "const": "custom" } } }, "then": { "required": ["provider"] } }
      ]
    },
    "lorePage": {
      "type": "object",
      "required": ["text"],
      "properties": { "title": { "type": "string", "maxLength": 200 }, "text": { "type": "string", "maxLength": 20000 }, "icon": { "$ref": "#/definitions/registryId" } }
    },
    "dialogue": {
      "type": "object",
      "required": ["id", "lines"],
      "properties": {
        "id": { "$ref": "#/definitions/localId" },
        "title": { "type": "string", "maxLength": 200 },
        "gate": { "enum": ["none", "accept", "claim"] },
        "lines": {
          "type": "array", "minItems": 1, "maxItems": 2000,
          "items": {
            "type": "object", "required": ["text"],
            "properties": {
              "speaker": { "type": "string", "maxLength": 100 },
              "text": { "type": "string", "maxLength": 4000 },
              "choices": { "type": "array", "maxItems": 16, "items": {
                "type": "object", "required": ["text"],
                "properties": { "text": { "type": "string", "maxLength": 300 }, "next": { "type": "integer", "minimum": -1, "maximum": 2000 } } } }
            }
          }
        }
      }
    }
  }
}
